<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ON: Samsung One UI Blue Pill -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#2B78E4" />
            <size android:width="48dp" android:height="28dp" />
        </shape>
    </item>
    <!-- OFF: Distinct dark grey pill with subtle outline for card contrast -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#36363A" />
            <stroke android:width="1dp" android:color="#4E4E54" />
            <size android:width="48dp" android:height="28dp" />
        </shape>
    </item>
</selector>
